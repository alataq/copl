import copl.vector;

public class Repository<t> {
    private std::Vector<t> items;

    public Repository() {
        self.items = new std::Vector<t>();
    }

    public void add(t item) {
        self.items.add(item);
    }

    public t get(int index) {
        return self.items.get(index);
    }

    public int getLength() {
        return self.items.getLength();
    }

    public bool removeAt(int index) {
        if(index < 0 || index >= self.items.getLength()) {
            return false;
        }
        std::Vector<t> next = new std::Vector<t>();
        for(int i = 0; i < self.items.getLength(); i++) {
            if(i != index) {
                next.add(self.items.get(i));
            }
        }
        self.items = next;
        return true;
    }
}
