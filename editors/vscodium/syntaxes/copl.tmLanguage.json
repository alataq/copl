{
  "name": "COPL",
  "scopeName": "source.copl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#namespace-name" },
    { "include": "#type-declaration" },
    { "include": "#primitive-types" },
    { "include": "#self-members" },
    { "include": "#member-access" },
    { "include": "#function-call" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#type-identifier" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.copl", "match": "//.*$" },
        { "name": "comment.block.copl", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.copl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.copl", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.copl",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.copl", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.copl", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.copl", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.octal.copl", "match": "\\b0[oO][0-7_]+\\b" },
        { "name": "constant.numeric.float.copl", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.integer.copl", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "namespace-name": {
      "patterns": [
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.namespace.copl" },
            "2": { "name": "entity.name.namespace.copl" }
          }
        }
      ]
    },
    "type-declaration": {
      "patterns": [
        {
          "match": "\\b(class|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.copl" },
            "2": { "name": "entity.name.type.copl" }
          }
        }
      ]
    },
    "primitive-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.copl",
          "match": "\\b(void|int|uint|i32|u32|byte|char|float|bool|ptr)\\b"
        }
      ]
    },
    "self-members": {
      "patterns": [
        {
          "match": "\\b(self)\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.language.self.copl" },
            "2": { "name": "variable.other.property.copl" }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.property.copl" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.copl" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.copl",
          "match": "\\b(if|else|switch|case|default|for|while|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.copl",
          "match": "\\b(import|extends|implements|new)\\b"
        },
        {
          "name": "storage.modifier.copl",
          "match": "\\b(public|protected|internal|private|final|static|extern)\\b"
        },
        {
          "name": "constant.language.copl",
          "match": "\\b(null|true|false|super)\\b"
        },
        {
          "name": "keyword.other.copl",
          "match": "\\b(cinclude|clink)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.copl",
          "match": "\\b(env|syscall|copy)\\b"
        },
        {
          "name": "support.function.vararg.copl",
          "match": "\\b(va_int|va_i32|va_u32|va_uint|va_float|va_bool|va_char|va_ptr|va_char_array)\\b"
        }
      ]
    },
    "type-identifier": {
      "patterns": [
        {
          "name": "entity.name.type.copl",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.copl",
          "match": "(\\+\\+|--|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|::|->|[+\\-*/%&|^~!<>=])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.copl",
          "match": "[{}\\[\\]();,.?:]"
        }
      ]
    }
  }
}
