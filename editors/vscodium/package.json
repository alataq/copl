{
  "name": "copl-vscode",
  "displayName": "COPL",
  "description": "COPL language support for VSCodium",
  "version": "0.1.4",
  "publisher": "local",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "copl",
        "aliases": [
          "COPL"
        ],
        "extensions": [
          ".copl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "copl",
        "scopeName": "source.copl",
        "path": "./syntaxes/copl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "COPL",
      "properties": {
        "copl.server.command": {
          "type": "string",
          "default": "/home/alataq/.bun/bin/bun",
          "description": "Language server executable."
        },
        "copl.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "run",
            "/home/alataq/coding/copl/src/cli.ts",
            "lsp",
            "--stdio"
          ],
          "description": "Language server arguments."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "license": "Apache-2.0"
}
