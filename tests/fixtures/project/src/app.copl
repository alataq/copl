namespace app {
  public final class App {
    private int count;
    public App() {
      self.count = 0;
    }

    public int run(int[] args) {
      Vector<int> v = new Vector<int>();
      for (int i = 0; i < args.len; i = i + 1) {
        v.push(args[i]);
      }
      if (self.count == 0) {
        self.count = 1;
      } else if (self.count == 1) {
        self.count = 2;
      } else {
        self.count = 3;
      }
      while (self.count < 3) {
        self.count += 1;
      }
      switch (self.count) {
        case 1:
          break;
        default:
          break;
      }
      &work(4);
      &2work2(args);
      $APP_HOME = "/tmp/app";
      return v.len;
    }

    private void work(int n) {
      syscall(1, 2, 3);
      char[] home = env("APP_HOME");
    }

    private void work2(int[] values) {
      int x = int(3.5);
    }
  }

  public class Vector<t> {
    private t[] data;
    public int len;

    public Vector() {
      self.data = new t[16];
      self.len = 0;
    }

    public void push(t value) {
      self.data[self.len] = value;
      self.len++;
    }
  }
}
